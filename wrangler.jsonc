{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tack",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-16",

  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "tack.squeakyfiddlepro.me", "custom_domain": true },
    { "pattern": "list.tack.squeakyfiddlepro.me", "custom_domain": true },
    { "pattern": "private.tack.squeakyfiddlepro.me", "custom_domain": true }
  ],
  "vars": {
    "DOCS_HOST": "tack.squeakyfiddlepro.me",
    "LIST_HOST": "list.tack.squeakyfiddlepro.me",
    "PRIVATE_HOST": "private.tack.squeakyfiddlepro.me",
    "PRIVATE_AUTH": "token"
  },

  "build": { "command": "bun run build" },
  "assets": { "directory": "./dist" },

  "durable_objects": {
    "bindings": [
      { "name": "LIVE", "class_name": "Live" },
      { "name": "STORE", "class_name": "Store" },
      { "name": "BLOBS", "class_name": "Blobs" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Live"] },
    { "tag": "v2", "new_sqlite_classes": ["Store"] },
    { "tag": "v3", "new_sqlite_classes": ["Blobs"] }
  ]
}
